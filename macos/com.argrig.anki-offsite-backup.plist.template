<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.argrig.anki-offsite-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__SCRIPT_PATH__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ANKI_OFFSITE_BACKUP_DIR</key>
    <string>__BACKUP_PATH__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>13</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/com.argrig.anki-offsite-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.argrig.anki-offsite-backup.err</string>
</dict>
</plist>

